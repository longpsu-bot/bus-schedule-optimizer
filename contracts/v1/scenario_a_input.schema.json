{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bus-schedule.example/contracts/v1/scenario_a_input.schema.json",
  "title": "ScenarioAInput",
  "description": "Normalized current operating plan and exact timetable observed as Scenario A.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "scenario_id", "route_id", "route_name", "route_type",
    "terminal_1_name", "terminal_2_name", "trip_runtime_minutes", "turnaround_minutes",
    "total_daily_trips", "trips_by_direction", "first_departures", "last_departures",
    "vehicle_capacity", "available_fleet_limit", "operating_day_type",
    "exact_timetable", "source_metadata"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0", "description": "Engine contract version."},
    "scenario_id": {"type": "string", "const": "A"},
    "route_id": {"type": "string", "minLength": 1},
    "route_name": {"type": "string", "minLength": 1},
    "route_type": {"enum": ["intra_provincial", "inter_provincial"]},
    "terminal_1_name": {"type": "string", "minLength": 1},
    "terminal_2_name": {"type": "string", "minLength": 1},
    "trip_runtime_minutes": {"type": "integer", "minimum": 1},
    "turnaround_minutes": {
      "type": "object", "additionalProperties": false,
      "required": ["terminal_1", "terminal_2"],
      "properties": {
        "terminal_1": {"type": "integer", "minimum": 0},
        "terminal_2": {"type": "integer", "minimum": 0}
      }
    },
    "total_daily_trips": {"type": "integer", "minimum": 1},
    "trips_by_direction": {
      "type": "object", "additionalProperties": false,
      "required": ["outbound", "inbound"],
      "properties": {
        "outbound": {"type": "integer", "minimum": 1},
        "inbound": {"type": "integer", "minimum": 1}
      }
    },
    "first_departures": {"$ref": "#/$defs/terminalTimes"},
    "last_departures": {"$ref": "#/$defs/terminalTimes"},
    "vehicle_capacity": {"type": "integer", "minimum": 1, "description": "Blocking required field; never inferred."},
    "approved_active_fleet": {"type": ["integer", "null"], "minimum": 1, "description": "Optional governance metadata; not the default technical equality constraint."},
    "available_fleet_limit": {"type": "integer", "minimum": 1, "description": "Required hard upper bound on vehicles assigned to the route."},
    "operating_day_type": {
      "enum": ["weekday", "saturday", "sunday", "holiday", "special", "all_days"],
      "description": "all_days means one authoritative timetable applies identically across all listed day classifications; it grants no demand-coverage or calendar-date inference."
    },
    "exact_timetable": {
      "type": "array", "minItems": 2, "items": {"$ref": "#/$defs/trip"}
    },
    "source_metadata": {"$ref": "#/$defs/sourceMetadata"}
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "terminalTimes": {
      "type": "object", "additionalProperties": false,
      "required": ["terminal_1", "terminal_2"],
      "properties": {"terminal_1": {"$ref": "#/$defs/time"}, "terminal_2": {"$ref": "#/$defs/time"}}
    },
    "trip": {
      "type": "object", "additionalProperties": false,
      "required": ["trip_id", "direction", "departure_terminal", "departure_time", "runtime_minutes"],
      "properties": {
        "trip_id": {"type": "string", "minLength": 1},
        "direction": {"enum": ["outbound", "inbound"]},
        "departure_terminal": {"enum": ["terminal_1", "terminal_2"]},
        "departure_time": {"$ref": "#/$defs/time"},
        "arrival_time": {"$ref": "#/$defs/time"},
        "runtime_minutes": {"type": "integer", "minimum": 1},
        "vehicle_assignment": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "sourceMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "source_id", "imported_at"],
      "properties": {
        "source_type": {"enum": ["xlsx", "ui", "api", "manual", "other"]},
        "source_id": {"type": "string", "minLength": 1},
        "imported_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  }
}

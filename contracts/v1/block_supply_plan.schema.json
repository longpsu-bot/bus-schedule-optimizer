{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bus-schedule.example/contracts/v1/block_supply_plan.schema.json",
  "title": "BlockSupplyPlan",
  "description": "Authoritative demand and service allocation/evaluation for one scenario, direction, and analysis block.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "scenario", "direction", "block_id", "block_start", "block_end", "duration_minutes",
    "passenger_demand", "demand_rate_per_hour", "vehicle_capacity", "a_trip_count", "b_trip_count",
    "c_planned_trip_count", "c_actual_trip_count", "trip_rate_per_hour", "required_trips_85",
    "required_trips_90", "required_trip_rate_85", "required_trip_rate_90", "nominal_capacity",
    "capacity_at_85", "capacity_at_90", "load_factor", "shortage", "status", "allocation_reason", "confidence"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "scenario": {"enum": ["A", "B", "C"]},
    "direction": {"enum": ["outbound", "inbound", "combined"]},
    "block_id": {"type": "string", "minLength": 1},
    "block_start": {"$ref": "#/$defs/time"},
    "block_end": {"$ref": "#/$defs/time"},
    "duration_minutes": {"type": "integer", "minimum": 1},
    "passenger_demand": {"type": "number", "minimum": 0},
    "demand_rate_per_hour": {"type": "number", "minimum": 0},
    "vehicle_capacity": {"type": "integer", "minimum": 1},
    "a_trip_count": {"type": ["integer", "null"], "minimum": 0},
    "b_trip_count": {"type": ["integer", "null"], "minimum": 0},
    "c_planned_trip_count": {"type": ["integer", "null"], "minimum": 0},
    "c_actual_trip_count": {"type": ["integer", "null"], "minimum": 0},
    "trip_rate_per_hour": {"type": "number", "minimum": 0},
    "required_trips_85": {"type": "integer", "minimum": 0},
    "required_trips_90": {"type": "integer", "minimum": 0},
    "required_trip_rate_85": {"type": "number", "minimum": 0},
    "required_trip_rate_90": {"type": "number", "minimum": 0},
    "nominal_capacity": {"type": "number", "minimum": 0},
    "capacity_at_85": {"type": "number", "minimum": 0},
    "capacity_at_90": {"type": "number", "minimum": 0},
    "load_factor": {"type": ["number", "null"], "minimum": 0},
    "shortage": {"type": "number", "minimum": 0},
    "status": {"enum": ["WITHIN_PLANNING_CEILING", "WARNING_ABOVE_85", "CRITICAL_ABOVE_90", "NO_SERVICE_WITH_DEMAND", "LOW_LOAD_REVIEW_ONLY", "ELIGIBLE_DONOR_PERIOD", "INSUFFICIENT_DATA"]},
    "allocation_reason": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]}
  },
  "$defs": {"time": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"}}
}

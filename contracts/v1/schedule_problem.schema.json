{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bus-schedule.example/contracts/v1/schedule_problem.schema.json",
  "title": "ScheduleProblemV1",
  "description": "Canonical, solver-independent Contract V1 request for generating Scenario C.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "problem_id",
    "problem_fingerprint",
    "evaluation_fingerprint",
    "source_a_fingerprint",
    "source_b_fingerprint",
    "observed_demand_fingerprint",
    "solver_adapter",
    "adapter_context_fingerprint",
    "scenario_a",
    "scenario_b",
    "demand_response_mode",
    "demand_resolution",
    "analysis_blocks",
    "operating_parameter_locks",
    "direction_trip_lock_mode",
    "direction_redistribution_authorization",
    "fleet_constraint_mode",
    "initial_fleet_positioning_mode",
    "fixed_initial_fleet",
    "bounded_initial_fleet",
    "planning_load_factor_ceiling",
    "critical_load_factor_ceiling",
    "block_requirements",
    "boundary_convention",
    "solver_policy"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "problem_id": {"type": "string", "pattern": "^PROBLEM-[A-F0-9]{16}$"},
    "problem_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "evaluation_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "source_a_fingerprint": {
      "anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]
    },
    "source_b_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "observed_demand_fingerprint": {
      "anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]
    },
    "solver_adapter": {"type": "string", "minLength": 1},
    "adapter_context_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "scenario_c_optimization_mode": {
      "const": "B_ANCHORED_TWO_STAGE_REBALANCE_V1"
    },
    "demand_allocation_authority_mode": {
      "enum": [
        "DIRECTIONAL_DEMAND_FIXED_DIRECTION_COUNTS",
        "COMBINED_DEMAND_FIXED_DIRECTION_COUNTS"
      ]
    },
    "scenario_a": {
      "anyOf": [{"$ref": "scenario_a_input.schema.json"}, {"type": "null"}]
    },
    "scenario_b": {
      "$ref": "scenario_b_input.schema.json",
      "description": "Canonical Scenario B, including optional per-terminal physical occupancy capacities when supplied."
    },
    "demand_response_mode": {
      "type": ["string", "null"],
      "enum": ["static", "elasticity_scenario", "calibrated", null]
    },
    "demand_resolution": {
      "anyOf": [{"$ref": "demand_resolution.schema.json"}, {"type": "null"}]
    },
    "analysis_blocks": {
      "type": "array",
      "items": {"$ref": "demand_analysis_block.schema.json"}
    },
    "operating_parameter_locks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lock"}
    },
    "direction_trip_lock_mode": {
      "enum": ["fixed_by_direction", "total_only"],
      "default": "fixed_by_direction"
    },
    "direction_redistribution_authorization": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["enabled", "authorized_by", "directional_demand_confidence"],
      "properties": {
        "enabled": {"type": "boolean"},
        "authorized_by": {"type": "string", "minLength": 1},
        "directional_demand_confidence": {
          "enum": ["high", "medium", "low", "unknown"]
        }
      }
    },
    "fleet_constraint_mode": {
      "enum": ["available_upper_bound", "exact_scheduled_fleet"],
      "default": "available_upper_bound",
      "description": "The Contract V1 implementation supports available_upper_bound."
    },
    "initial_fleet_positioning_mode": {
      "enum": ["solver_determined", "fixed", "bounded"],
      "default": "solver_determined"
    },
    "fixed_initial_fleet": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["terminal_1", "terminal_2"],
      "properties": {
        "terminal_1": {"type": "integer", "minimum": 0},
        "terminal_2": {"type": "integer", "minimum": 0}
      }
    },
    "bounded_initial_fleet": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["terminal_1", "terminal_2"],
      "properties": {
        "terminal_1": {"$ref": "#/$defs/initialFleetBounds"},
        "terminal_2": {"$ref": "#/$defs/initialFleetBounds"}
      }
    },
    "planning_load_factor_ceiling": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "critical_load_factor_ceiling": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "block_requirements": {
      "type": "array",
      "items": {"$ref": "block_supply_plan.schema.json"}
    },
    "boundary_convention": {
      "enum": [
        "half_open",
        "half_open_with_final_sentinel",
        "half_open_with_documented_final_inclusive"
      ]
    },
    "solver_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_limit_seconds",
        "worker_count",
        "random_seed",
        "require_independent_validation"
      ],
      "properties": {
        "time_limit_seconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "worker_count": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "random_seed": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "require_independent_validation": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"scenario_a": {"type": "null"}},
        "required": ["scenario_a"]
      },
      "then": {
        "properties": {"source_a_fingerprint": {"type": "null"}}
      },
      "else": {
        "properties": {
          "source_a_fingerprint": {"$ref": "#/$defs/fingerprint"}
        }
      }
    },
    {
      "if": {
        "properties": {"observed_demand_fingerprint": {"type": "null"}},
        "required": ["observed_demand_fingerprint"]
      },
      "then": {
        "properties": {
          "demand_response_mode": {"type": "null"},
          "demand_resolution": {"type": "null"},
          "analysis_blocks": {"maxItems": 0},
          "block_requirements": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "demand_response_mode": {
            "enum": ["static", "elasticity_scenario", "calibrated"]
          },
          "demand_resolution": {
            "$ref": "demand_resolution.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "demand_resolution": {
            "type": "object",
            "properties": {
              "source_resolution_type": {"const": "daily_total"}
            },
            "required": ["source_resolution_type"]
          }
        },
        "required": ["demand_resolution"]
      },
      "then": {
        "properties": {
          "analysis_blocks": {"maxItems": 0},
          "block_requirements": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "fleet_constraint_mode": {"const": "exact_scheduled_fleet"}
        },
        "required": ["fleet_constraint_mode"]
      },
      "then": {
        "properties": {
          "scenario_b": {
            "allOf": [
              {"$ref": "scenario_b_input.schema.json"},
              {
                "required": ["approved_active_fleet"],
                "properties": {
                  "approved_active_fleet": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "initial_fleet_positioning_mode": {"const": "fixed"}
        },
        "required": ["initial_fleet_positioning_mode"]
      },
      "then": {
        "properties": {
          "fixed_initial_fleet": {"type": "object"},
          "bounded_initial_fleet": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "initial_fleet_positioning_mode": {"const": "bounded"}
        },
        "required": ["initial_fleet_positioning_mode"]
      },
      "then": {
        "properties": {
          "fixed_initial_fleet": {"type": "null"},
          "bounded_initial_fleet": {"type": "object"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "initial_fleet_positioning_mode": {"const": "solver_determined"}
        },
        "required": ["initial_fleet_positioning_mode"]
      },
      "then": {
        "properties": {
          "fixed_initial_fleet": {"type": "null"},
          "bounded_initial_fleet": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "initialFleetBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0}
      },
      "description": "The domain validator enforces minimum <= maximum."
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value",
        "locked",
        "source_fingerprint",
        "authorized_exception"
      ],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "value": {},
        "locked": {"const": true},
        "source_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "authorized_exception": {"type": ["string", "null"]}
      }
    }
  }
}
